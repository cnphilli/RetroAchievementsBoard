{
  "name": "retroachievementsboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node dev-server.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "cf:deploy": "wrangler pages deploy dist --project-name retroachievements-board",
    "d1:create": "wrangler d1 create ra-achievements-cache",
    "d1:migrate:local": "wrangler d1 migrations apply ra-achievements-cache --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ra-achievements-cache --remote",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wrangler": "^4.124.0"
  }
}
